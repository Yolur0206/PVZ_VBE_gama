mov [ebx+AC],#1000

 push (float)200  // 将浮点数 10.0 的IEEE 754表示法 (0x41200000) 推入栈中
  movss xmm0, [esp]  // 将浮点数 10.0 从栈加载到XMM0寄存器
  add esp, 4  // 恢复栈指针
  // 加载 [ebx+2C] 的值到XMM1寄存器
  movss xmm1, [ebx+2C]
  // 将XMM1和XMM0相加，结果存储在XMM1
  addss xmm1, xmm0
  // 将结果存储回 [ebx+2C]
  movss [ebx+2C], xmm1

